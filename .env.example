# Supabase Configuration Example
# Copy this file to .env and fill in your actual Supabase project credentials:
# cp .env.example .env

# Your Supabase Project URL (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key (Anon Public key safe for client-side use)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Application Configuration
VITE_APP_NAME="ITAMS - IT Asset Management System"
VITE_APP_ENV=development
